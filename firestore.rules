rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── pendingConfessions ──────────────────────────────────────────────────
    // Auth'd users can create their own confessions (must start as "pending").
    // Nobody reads, updates, or deletes from the client — only the server
    // (via Admin SDK) mutates moderationStatus.
    match /pendingConfessions/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.moderationStatus == "pending";
      allow read, update, delete: if false;
    }

    // ── moderationLog ───────────────────────────────────────────────────────
    // Inaccessible to normal clients. Admins (users with isAdmin == true in
    // their users doc) can read for human review. Only the server writes.
    match /moderationLog/{docId} {
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid))
                       .data.isAdmin == true;
      allow write: if false;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Each auth'd user can read their own document (to check isFrozen).
    // Only the server (Admin SDK) writes user docs.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── reports ──────────────────────────────────────────────────────────────
    // Auth'd users can create reports during live drops. Write-only:
    // no read access, no updates, no deletes from the client.
    match /reports/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['dropId', 'reporterUid'])
                    && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── presence ────────────────────────────────────────────────────────────
    // Each auth'd user can write their own heartbeat. Only the server reads.
    match /presence/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if false;
    }

    // ── drops ───────────────────────────────────────────────────────────────
    // Clients can read drops where their UID is in the recipient list.
    // Only the server creates/updates drops.
    match /drops/{docId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.recipientUids;
      allow write: if false;

      // ── reactions subcollection under drops ──────────────────────────────
      // Clients who are recipients of the parent drop can read reaction counts
      // and increment them. Never store which user reacted.
      match /reactions/{emojiType} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/drops/$(docId))
                         .data.recipientUids;
        allow update: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/drops/$(docId))
                           .data.recipientUids
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count is int;
        allow create, delete: if false;
      }
    }

    // ── verdicts ──────────────────────────────────────────────────────────────
    // Reaction totals only (NO confession text). Readable by auth'd users.
    // Server (Admin SDK) writes verdicts upon drop expiry.
    match /verdicts/{dropId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── hallOfFameStats ──────────────────────────────────────────────────────
    // Pure aggregate emoji totals per day. Readable by any auth'd user.
    // No individual confession content — just vibe stats.
    // Only the server (Admin SDK) writes these.
    match /hallOfFameStats/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── _connectionTest ─────────────────────────────────────────────────────
    // Scoped to the user's own UID for the Firebase connection smoke test.
    match /_connectionTest/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == docId;
    }
  }
}
