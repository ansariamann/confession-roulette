rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── pendingConfessions ──────────────────────────────────────────────────
    // Auth'd users can create their own confessions (must start as "pending").
    // Nobody reads, updates, or deletes from the client — only the server
    // (via Admin SDK) mutates moderationStatus.
    match /pendingConfessions/{docId} {
      // Authors can read their own confession status (e.g. passed → scheduled).
      // All writes handled by Moderate Lambda (Admin SDK — bypasses rules).
      allow read: if request.auth != null
                  && resource.data.authorUid == request.auth.uid;
      allow update, delete, create: if false;
    }

    // ── moderationLog ───────────────────────────────────────────────────────
    // Inaccessible to normal clients. Admins (users with isAdmin == true in
    // their users doc) can read for human review. Only the server writes.
    match /moderationLog/{docId} {
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid))
                       .data.isAdmin == true;
      allow write: if false;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Each auth'd user can read their own document (to check isFrozen, communityId).
    // Users can also write their own communityId field.
    // Only the server (Admin SDK) writes isFrozen, reportCount, etc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['communityId']);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['communityId']);
    }

    // ── reports ──────────────────────────────────────────────────────────────
    // Auth'd users can create reports during live drops. Write-only:
    // no read access, no updates, no deletes from the client.
    match /reports/{docId} {
      // All writes handled by Report Lambda (Admin SDK — bypasses rules)
      allow read, update, delete, create: if false;
    }

    // ── presence ────────────────────────────────────────────────────────────
    // Each auth'd user can write their own heartbeat. Only the server reads.
    match /presence/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == "admin_bot_uid";
    }

    // ── drops ───────────────────────────────────────────────────────────────
    // Clients can read drops where their UID is in the recipient list.
    // Edge API creates drops using the bot user.
    match /drops/{docId} {
      allow read: if request.auth != null
                  && (request.auth.uid in resource.data.recipientUids || request.auth.uid == resource.data.authorUid);
      allow write, delete: if request.auth != null && request.auth.uid == "admin_bot_uid";

      // ── reactions subcollection under drops ──────────────────────────────
      // Clients who are recipients (or the author) of the parent drop can read reaction counts
      // Recipients can increment them. Never store which user reacted.
      match /reactions/{emojiType} {
        allow read: if request.auth != null
                    && (request.auth.uid in get(/databases/$(database)/documents/drops/$(docId)).data.recipientUids || request.auth.uid == get(/databases/$(database)/documents/drops/$(docId)).data.authorUid);
        allow update: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/drops/$(docId))
                           .data.recipientUids
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count is int;
        allow create, delete: if request.auth != null && request.auth.uid == "admin_bot_uid";
      }

      // ── voters subcollection: one-reaction-per-user enforcement ─────────
      // Each recipient can create exactly ONE voter doc keyed by their UID.
      // No updates or deletes — once you vote, it's permanent for that drop.
      // The client writes { emoji, votedAt } then increments the reaction count.
      match /voters/{voterId} {
        allow read: if request.auth != null
                    && request.auth.uid == voterId;
        allow create: if request.auth != null
                      && request.auth.uid == voterId
                      && request.auth.uid in
                         get(/databases/$(database)/documents/drops/$(docId))
                           .data.recipientUids
                      && request.resource.data.keys().hasAll(['emoji', 'votedAt'])
                      && request.resource.data.emoji is string;
        allow update, delete: if request.auth != null && request.auth.uid == "admin_bot_uid";
      }

      // ── comments subcollection: anonymous ephemeral comments ────────────
      // Recipients can read and create comments. No user identity stored
      // in the comment doc — comments are fully anonymous and ephemeral.
      match /comments/{commentId} {
        allow read: if request.auth != null
                    && (request.auth.uid == "admin_bot_uid" || request.auth.uid in get(/databases/$(database)/documents/drops/$(docId)).data.recipientUids || request.auth.uid == get(/databases/$(database)/documents/drops/$(docId)).data.authorUid);
        allow create: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/drops/$(docId))
                           .data.recipientUids
                      && request.resource.data.keys().hasAll(['text', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 80;
        allow update, delete: if request.auth != null && request.auth.uid == "admin_bot_uid";
      }
    }

    // ── verdicts ──────────────────────────────────────────────────────────────
    // Reaction totals only (NO confession text). Readable by auth'd users.
    // Edge API writes verdicts upon drop expiry.
    match /verdicts/{dropId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "admin_bot_uid";
    }

    // ── hallOfFameStats ──────────────────────────────────────────────────────
    // Pure aggregate emoji totals per day. Readable by any auth'd user.
    // No individual confession content — just vibe stats.
    // Only the server (Admin SDK) writes these.
    match /hallOfFameStats/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── communities ──────────────────────────────────────────────────────────
    // Community registry. Any auth'd user can read (for autocomplete search).
    // Any auth'd user can create a new community (name, type, createdAt, memberCount).
    // Only the server can update memberCount.
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['name', 'nameLower', 'type', 'createdAt', 'memberCount'])
                    && request.resource.data.memberCount == 1;
      allow update, delete: if false;
    }

    // ── wsConnections ────────────────────────────────────────────────────────
    // WebSocket connections tracking. No client access (Admin SDK only).
    match /wsConnections/{connectionId} {
      allow read, write: if false;
    }

    // ── _connectionTest ─────────────────────────────────────────────────────
    // Scoped to the user's own UID for the Firebase connection smoke test.
    match /_connectionTest/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == docId;
    }
  }
}
