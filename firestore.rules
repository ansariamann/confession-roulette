rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── pendingConfessions ──────────────────────────────────────────────────
    // No client writes. The /api/confess route writes via Admin token.
    // Authors can read their own confession status.
    match /pendingConfessions/{docId} {
      allow read: if request.auth != null
                  && resource.data.authorUid == request.auth.uid;
      allow write: if false;
    }

    // ── moderationLog ───────────────────────────────────────────────────────
    // Inaccessible to all clients.
    // Only the server (Admin token via /api/report) writes — bypasses these rules.
    // Admins with the isAdmin custom claim can read (for human review).
    match /moderationLog/{docId} {
      allow read: if request.auth != null
                  && request.auth.token.isAdmin == true;
      allow write: if false;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Each user can read their own doc and update only their communityId.
    // Server (Admin token) writes isFrozen, reportCount, etc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['communityId']);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['communityId']);
    }

    // ── reports ──────────────────────────────────────────────────────────────
    // Reports are submitted via /api/report (server-side) — no client access.
    match /reports/{docId} {
      allow read, write: if false;
    }

    // ── presence ─────────────────────────────────────────────────────────────
    // Each auth'd user writes their own heartbeat (lastSeen, communityId, sortKey).
    // No client reads — server samples presence for audience selection.
    match /presence/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if false;
    }

    // ── drops ────────────────────────────────────────────────────────────────
    // Recipients and the author can read their own drops.
    // Server creates and deletes drops.
    match /drops/{docId} {
      allow read: if request.auth != null
                  && (request.auth.uid in resource.data.recipientUids
                      || request.auth.uid == resource.data.authorUid);
      allow write: if false;

      // ── reactions subcollection ──────────────────────────────────────────
      // Recipients and the author can read live reaction counts.
      // Reactions are now written server-side via /api/react (Admin token).
      // Clients subscribe via onSnapshot for real-time updates.
      match /reactions/{emojiType} {
        allow read: if request.auth != null
                    && (request.auth.uid in get(/databases/$(database)/documents/drops/$(docId)).data.recipientUids
                        || request.auth.uid == get(/databases/$(database)/documents/drops/$(docId)).data.authorUid);
        allow write: if false;
      }

      // ── voters subcollection ─────────────────────────────────────────────
      // Clients can read their own voter doc (to check if already voted on load).
      // Votes are written server-side via /api/react (Admin token).
      match /voters/{voterId} {
        allow read: if request.auth != null && request.auth.uid == voterId;
        allow write: if false;
      }

      // ── comments subcollection ───────────────────────────────────────────
      // Recipients and the author can read and create comments.
      // Comments are anonymous (no uid stored in doc — only text + createdAt).
      match /comments/{commentId} {
        allow read: if request.auth != null
                    && (request.auth.uid in get(/databases/$(database)/documents/drops/$(docId)).data.recipientUids
                        || request.auth.uid == get(/databases/$(database)/documents/drops/$(docId)).data.authorUid);
        allow create: if request.auth != null
                      && (request.auth.uid in get(/databases/$(database)/documents/drops/$(docId)).data.recipientUids
                          || request.auth.uid == get(/databases/$(database)/documents/drops/$(docId)).data.authorUid)
                      && request.resource.data.keys().hasAll(['text', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 80;
        allow update, delete: if false;
      }
    }

    // ── verdicts ──────────────────────────────────────────────────────────────
    // Verdicts contain reaction totals + confession text (for author view).
    // Readable by the author and any user who was a recipient of that drop.
    // Server writes verdicts via /api/expire (Admin token).
    match /verdicts/{dropId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.authorUid
                      || request.auth.uid in resource.data.recipientUids);
      allow write: if false;
    }

    // ── hallOfFameStats ──────────────────────────────────────────────────────
    // Pure aggregate emoji totals per day. Readable by any auth'd user.
    // No individual confession content — vibe stats only.
    // Server writes via /api/expire (Admin token, field transforms).
    match /hallOfFameStats/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── communities ──────────────────────────────────────────────────────────
    // Community registry. Auth'd users can read.
    // Creating/joining is handled server-side via /api/community/join.
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── wsConnections ────────────────────────────────────────────────────────
    // WebSocket connection tracking. Server-only.
    match /wsConnections/{connectionId} {
      allow read, write: if false;
    }

    // ── _connectionTest ──────────────────────────────────────────────────────
    // Firebase connection smoke test. Scoped to the user's own UID.
    match /_connectionTest/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == docId;
    }
  }
}
